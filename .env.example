# Copie ce fichier en ".env" (non versionné) et renseigne ta chaîne de
# connexion Postgres, récupérée dans Supabase :
# Project Settings → Database → Connection string → "URI" (mode "Transaction" ou "Session")
#
# Exemple de format :
# DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@db.xxxxxxxxxxxx.supabase.co:5432/postgres

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campusflow-resources
