# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# Calendar
COMMON_CALENDAR_URL=https://your-university-ical-url

# Supabase (for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=campusflow-resources

# Initial password for student accounts (used during provisioning)
INITIAL_PASSWORD=change_me_before_deployment
