# Block sensitive files
<FilesMatch "^\.|gate\.php$|\.sql$|\.yaml$|\.conf$|composer\.(json|lock)$|Dockerfile$|proxy-server\.js$|package(-lock)?\.json$|provision\.php$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Keep the API behind api.php and let PHP enforce the session.
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]

# Public authentication assets/pages.
RewriteRule ^(?:login|setup)\.php$ - [L]
RewriteRule ^(?:auth|setup)\.js$ - [L]
RewriteRule ^auth\.css$ - [L]

# PHP pages authenticate themselves through the shared bootstrap. Keep old
# HTML URLs as redirects during the migration instead of serving duplicate pages.
RewriteRule ^(?:index|tasks|add|courses|timetable|settings)\.html$ /$1.php [R=302,L]
RewriteRule ^login\.html$ /login.php [R=302,L]
RewriteRule ^setup\.html$ /setup.php [R=302,L]
RewriteRule ^admin-login\.html$ /admin-login.php [R=302,L]
RewriteRule ^guest\.html$ /guest.php [R=302,L]
